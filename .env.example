# Environment variables for the pve CLI
# Copy to .env (or export directly) and adjust values as needed

# Proxmox connection settings
PVE_HOST=pve.example.com
PVE_USER=cli-user@pve
PVE_TOKEN_NAME=token-name
PVE_TOKEN_VALUE=your-proxmox-api-token-value-here

# Optional: password authentication instead of API token (not recommended)
# PVE_PASSWORD=your-password

# Optional overrides
# PVE_PORT=8006
# PVE_VERIFY_SSL=true
# PVE_CA_CERT=/path/to/ca-bundle.pem   # verify TLS against a private CA (recommended over disabling verification)
# PVE_TASK_TIMEOUT=5m
# PVE_OPERATIONS_MAX_CONCURRENT_SNAPSHOTS=2
# PVE_OPERATIONS_MAX_CONCURRENT_VM_OPS=3
# PVE_LOGGING_LEVEL=info
# PVE_CLI_BATCH_MODE=false
